@{
    var title = ViewData["Title"]?.ToString() ?? "Quản lý phòng khám";
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? string.Empty;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var userName = User.Identity?.Name ?? "Nhân viên";

    var roleLabel = area switch
    {
        "Admin" => "Quản trị viên",
        "LeTan" => "Lễ tân",
        "BacSi" => "Bác sĩ",
        _ => "Nhân viên"
    };

    var notificationController = area is "LeTan" or "BacSi" ? "ThongBao" : string.Empty;

    string IsActive(string targetController) =>
        string.Equals(controller, targetController, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Phòng Khám Đa Khoa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="pk-staff-wrapper">
        <div class="pk-sidebar-overlay" id="pkSidebarOverlay" aria-hidden="true"></div>

        <aside class="pk-sidebar" id="pkSidebar" aria-label="Điều hướng khu vực nhân viên">
            <div class="pk-sidebar-brand">
                <a asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-hospital-fill fs-5 text-info" aria-hidden="true"></i>
                    <span>Phòng Khám</span>
                </a>
                <button type="button" class="btn btn-sm text-white d-lg-none" id="pkSidebarClose" aria-label="Đóng menu">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>

            <nav class="pk-sidebar-nav">
                <div class="pk-sidebar-section">@roleLabel</div>

                @if (string.Equals(area, "Admin", StringComparison.OrdinalIgnoreCase))
                {
                    <a class="pk-sidebar-link @IsActive("ThongKe")" asp-area="Admin" asp-controller="ThongKe" asp-action="Index">
                        <i class="bi bi-bar-chart-line" aria-hidden="true"></i><span>Thống kê</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("TaiKhoan")" asp-area="Admin" asp-controller="TaiKhoan" asp-action="Index">
                        <i class="bi bi-people" aria-hidden="true"></i><span>Tài khoản</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("ChuyenKhoa")" asp-area="Admin" asp-controller="ChuyenKhoa" asp-action="Index">
                        <i class="bi bi-diagram-3" aria-hidden="true"></i><span>Chuyên khoa</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("BacSi")" asp-area="Admin" asp-controller="BacSi" asp-action="Index">
                        <i class="bi bi-person-badge" aria-hidden="true"></i><span>Bác sĩ</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("NhanVien")" asp-area="Admin" asp-controller="NhanVien" asp-action="Index">
                        <i class="bi bi-person-vcard" aria-hidden="true"></i><span>Nhân viên</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("CaLamViec")" asp-area="Admin" asp-controller="CaLamViec" asp-action="Index">
                        <i class="bi bi-clock" aria-hidden="true"></i><span>Ca làm việc</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("LichLamViec")" asp-area="Admin" asp-controller="LichLamViec" asp-action="Index">
                        <i class="bi bi-calendar3" aria-hidden="true"></i><span>Lịch làm việc</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("NhomThuoc")" asp-area="Admin" asp-controller="NhomThuoc" asp-action="Index">
                        <i class="bi bi-collection" aria-hidden="true"></i><span>Nhóm thuốc</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("Thuoc")" asp-area="Admin" asp-controller="Thuoc" asp-action="Index">
                        <i class="bi bi-capsule" aria-hidden="true"></i><span>Thuốc</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("DichVu")" asp-area="Admin" asp-controller="DichVu" asp-action="Index">
                        <i class="bi bi-heart-pulse" aria-hidden="true"></i><span>Dịch vụ</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("DanhGia")" asp-area="Admin" asp-controller="DanhGia" asp-action="Index">
                        <i class="bi bi-star" aria-hidden="true"></i><span>Đánh giá</span>
                    </a>
                }
                else if (string.Equals(area, "LeTan", StringComparison.OrdinalIgnoreCase))
                {
                    <a class="pk-sidebar-link @IsActive("LichHen")" asp-area="LeTan" asp-controller="LichHen" asp-action="Index">
                        <i class="bi bi-calendar-check" aria-hidden="true"></i><span>Quản lý lịch hẹn</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("TiepDon")" asp-area="LeTan" asp-controller="TiepDon" asp-action="Index">
                        <i class="bi bi-person-check" aria-hidden="true"></i><span>Tiếp đón</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("BenhNhan")" asp-area="LeTan" asp-controller="BenhNhan" asp-action="Index">
                        <i class="bi bi-people" aria-hidden="true"></i><span>Bệnh nhân</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("ThanhToan")" asp-area="LeTan" asp-controller="ThanhToan" asp-action="Index">
                        <i class="bi bi-cash-coin" aria-hidden="true"></i><span>Thanh toán</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("ThongBao")" asp-area="LeTan" asp-controller="ThongBao" asp-action="Index">
                        <i class="bi bi-bell" aria-hidden="true"></i><span>Thông báo</span>
                    </a>
                }
                else if (string.Equals(area, "BacSi", StringComparison.OrdinalIgnoreCase))
                {
                    <a class="pk-sidebar-link @IsActive("DanhSachCho")" asp-area="BacSi" asp-controller="DanhSachCho" asp-action="Index">
                        <i class="bi bi-list-ol" aria-hidden="true"></i><span>Danh sách chờ</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("LichLamViec")" asp-area="BacSi" asp-controller="LichLamViec" asp-action="Index">
                        <i class="bi bi-calendar3" aria-hidden="true"></i><span>Lịch làm việc</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("PhieuKham")" asp-area="BacSi" asp-controller="PhieuKham" asp-action="Index">
                        <i class="bi bi-clipboard2-pulse" aria-hidden="true"></i><span>Phiếu khám</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("BenhNhan")" asp-area="BacSi" asp-controller="BenhNhan" asp-action="Index">
                        <i class="bi bi-file-medical" aria-hidden="true"></i><span>Bệnh nhân đã khám</span>
                    </a>
                    <a class="pk-sidebar-link @IsActive("ThongBao")" asp-area="BacSi" asp-controller="ThongBao" asp-action="Index">
                        <i class="bi bi-bell" aria-hidden="true"></i><span>Thông báo</span>
                    </a>
                }
            </nav>
        </aside>

        <div class="pk-staff-main">
            <header class="pk-topbar">
                <div class="d-flex align-items-center gap-2 min-w-0">
                    <button type="button" class="btn btn-secondary d-lg-none px-2" id="pkSidebarToggle"
                            aria-controls="pkSidebar" aria-expanded="false" aria-label="Mở menu">
                        <i class="bi bi-list fs-5" aria-hidden="true"></i>
                    </button>
                    <h1 class="pk-topbar-title">@title</h1>
                </div>

                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    @if (!string.IsNullOrEmpty(notificationController))
                    {
                        <a class="pk-bell-btn" asp-area="@area" asp-controller="@notificationController" asp-action="Index" aria-label="Thông báo">
                            <i class="bi bi-bell fs-5" aria-hidden="true"></i>
                            <span class="badge rounded-pill bg-danger pk-bell-badge d-none" id="pkNotificationBadge">0</span>
                        </a>
                    }
                    else
                    {
                        <button type="button" class="pk-bell-btn" aria-label="Thông báo" title="Thông báo">
                            <i class="bi bi-bell fs-5" aria-hidden="true"></i>
                            <span class="badge rounded-pill bg-danger pk-bell-badge d-none" id="pkNotificationBadge">0</span>
                        </button>
                    }

                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle" aria-hidden="true"></i>
                            <span class="d-none d-sm-inline">@userName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li class="px-3 py-2 small text-muted">
                                <div class="fw-semibold text-dark">@userName</div>
                                <div>@roleLabel</div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item py-2" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house me-2" aria-hidden="true"></i>Trang công khai
                                </a>
                            </li>
                            <li>
                                <form method="post" action="/Account/Logout" class="px-2 py-1">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger rounded py-2">
                                        <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main role="main" class="pk-staff-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_ToastPartial" />
    <partial name="_ConfirmModalPartial" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
