@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="card p-4 my-4">
    <h1 class="h3 text-danger mb-2">Đã xảy ra lỗi</h1>
    <p class="mb-3">Hệ thống gặp sự cố trong quá trình xử lý yêu cầu của bạn. Vui lòng thử lại sau.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mb-3">
            <strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <div>
        <a class="btn btn-secondary" asp-area="" asp-controller="Home" asp-action="Index">Quay về trang chủ</a>
    </div>
</div>
