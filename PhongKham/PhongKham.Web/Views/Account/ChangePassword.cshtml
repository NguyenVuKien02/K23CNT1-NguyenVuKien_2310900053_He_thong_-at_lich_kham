@model PhongKham.Web.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    var backUrl = "/";
    if (User.IsInRole(RoleNames.Admin))
    {
        backUrl = "/Admin/ThongKe";
    }
    else if (User.IsInRole(RoleNames.Receptionist))
    {
        backUrl = "/LeTan/LichHen";
    }
    else if (User.IsInRole(RoleNames.Doctor))
    {
        backUrl = "/BacSi/DanhSachCho";
    }
}

<div class="row justify-content-center py-3 py-md-4">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                         style="width: 56px; height: 56px; background-color: var(--pk-primary-soft); color: var(--pk-primary);">
                        <i class="bi bi-key-fill fs-3" aria-hidden="true"></i>
                    </div>
                    <h1 class="h4 fw-bold mb-1">Đổi mật khẩu</h1>
                    <p class="text-muted small mb-0">Cập nhật mật khẩu mới để bảo mật tài khoản của bạn</p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
                        <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                    </div>
                }

                <form asp-action="ChangePassword" asp-controller="Account" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-medium">
                            Mật khẩu hiện tại <span class="text-danger">*</span>
                        </label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu hiện tại" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-medium">
                            Mật khẩu mới <span class="text-danger">*</span>
                        </label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="Tối thiểu 8 ký tự, gồm chữ và số" />
                        <span asp-validation-for="NewPassword" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-medium">
                            Xác nhận mật khẩu mới <span class="text-danger">*</span>
                        </label>
                        <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="form-text mb-4">
                        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                        Mật khẩu mới phải có ít nhất 8 ký tự, bao gồm cả chữ cái và chữ số.
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <a href="@backUrl" class="btn btn-secondary flex-fill">
                            <i class="bi bi-arrow-left" aria-hidden="true"></i>
                            <span>Quay lại</span>
                        </a>
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-check-lg" aria-hidden="true"></i>
                            <span>Lưu mật khẩu</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
