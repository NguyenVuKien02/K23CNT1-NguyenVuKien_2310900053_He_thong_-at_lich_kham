@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm text-center">
            <div class="card-body p-4 p-md-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                     style="width: 68px; height: 68px; background-color: #FDECEC; color: var(--pk-danger);">
                    <i class="bi bi-shield-lock-fill fs-2" aria-hidden="true"></i>
                </div>
                <h1 class="h4 fw-bold text-danger mb-2">Từ chối truy cập (403)</h1>
                <p class="text-muted mb-4">
                    Bạn không có quyền truy cập vào trang hoặc chức năng này.
                    Vui lòng quay lại trang chủ hoặc đăng nhập bằng tài khoản có quyền phù hợp.
                </p>
                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-house" aria-hidden="true"></i>
                        <span>Về trang chủ</span>
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-secondary w-100">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                <span>Đăng xuất</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-secondary">
                            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                            <span>Đăng nhập</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
