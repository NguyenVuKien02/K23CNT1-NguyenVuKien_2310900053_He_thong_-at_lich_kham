@model PhongKham.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center py-3 py-md-5">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
        <div class="card shadow-sm">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                         style="width: 56px; height: 56px; background-color: var(--pk-primary-soft); color: var(--pk-primary);">
                        <i class="bi bi-box-arrow-in-right fs-3" aria-hidden="true"></i>
                    </div>
                    <h1 class="h4 fw-bold mb-1">Đăng nhập</h1>
                    <p class="text-muted small mb-0">Đăng nhập vào hệ thống Phòng Khám Đa Khoa</p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
                        <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                    </div>
                }

                <form asp-action="Login" asp-controller="Account" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="ReturnUrl" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-medium">
                            Email <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Email" class="form-control" autocomplete="username" placeholder="example@email.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-medium">
                            Mật khẩu <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                        <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                            <span>Đăng nhập</span>
                        </button>
                    </div>
                </form>

                <hr class="my-4" />

                <p class="text-center text-muted mb-0">
                    Chưa có tài khoản bệnh nhân?
                    <a asp-action="Register" asp-controller="Account" class="fw-semibold text-decoration-none">Đăng ký ngay</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
