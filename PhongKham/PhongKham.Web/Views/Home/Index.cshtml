@model PhongKham.Web.ViewModels.Public.HomeIndexViewModel
@{
    ViewData["Title"] = "Trang chủ";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isPatient = isAuthenticated && User.IsInRole(RoleNames.Patient);
    var datLichHref = isPatient
        ? "/BenhNhan/LichHen/DatLich"
        : $"/Account/Login?returnUrl={Uri.EscapeDataString("/BenhNhan/LichHen/DatLich")}";
}

<!-- Banner Hero -->
<section class="pk-hero mb-4">
    <div class="row align-items-center gy-4">
        <div class="col-lg-7">
            <span class="pk-hero-badge mb-3">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <span>Chăm sóc sức khỏe chủ động &amp; tận tâm</span>
            </span>
            <h1 class="pk-hero-title mb-3">
                Đặt lịch khám trực tuyến nhanh chóng, quản lý hồ sơ sức khỏe tiện lợi
            </h1>
            <p class="pk-hero-subtitle mb-4">
                Chủ động chọn chuyên khoa, bác sĩ và khung giờ phù hợp. Giảm thời gian chờ đợi tại quầy và theo dõi toàn bộ kết quả khám, đơn thuốc ngay trên hệ thống.
            </p>
            <div class="d-flex flex-column flex-sm-row gap-2">
                @if (!isAuthenticated || isPatient)
                {
                    <a href="@datLichHref" class="btn btn-light text-primary fw-semibold px-4">
                        <i class="bi bi-calendar2-check" aria-hidden="true"></i>
                        <span>Đặt lịch khám ngay</span>
                    </a>
                }
                <a href="/bac-si" class="btn pk-btn-hero-outline px-4">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span>Tìm bác sĩ</span>
                </a>
                <a href="/bang-gia" class="btn pk-btn-hero-outline px-4">
                    <i class="bi bi-tags" aria-hidden="true"></i>
                    <span>Xem bảng giá</span>
                </a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="row g-3">
                <div class="col-4 col-lg-6">
                    <div class="pk-hero-stat h-100">
                        <div class="pk-hero-stat-value">@Model.TongChuyenKhoa</div>
                        <div class="pk-hero-stat-label">Chuyên khoa</div>
                    </div>
                </div>
                <div class="col-4 col-lg-6">
                    <div class="pk-hero-stat h-100">
                        <div class="pk-hero-stat-value">@Model.TongBacSi</div>
                        <div class="pk-hero-stat-label">Bác sĩ công tác</div>
                    </div>
                </div>
                <div class="col-4 col-lg-12">
                    <div class="pk-hero-stat h-100 d-flex flex-column flex-lg-row align-items-lg-center justify-content-lg-between gap-2">
                        <div>
                            <div class="pk-hero-stat-value">@Model.TongDichVu</div>
                            <div class="pk-hero-stat-label">Dịch vụ khám &amp; cận lâm sàng</div>
                        </div>
                        <i class="bi bi-clipboard2-pulse fs-2 d-none d-lg-inline opacity-75" aria-hidden="true"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Quick Search Bar -->
<section class="mb-5" aria-label="Tìm nhanh bác sĩ và lịch khám">
    <div class="card pk-quick-search">
        <div class="card-body p-3 p-md-4">
            <form method="get" action="/bac-si" class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label for="quickChuyenKhoa" class="form-label fw-semibold small text-muted mb-1">
                        <i class="bi bi-hospital me-1 text-primary" aria-hidden="true"></i>Chuyên khoa
                    </label>
                    <select id="quickChuyenKhoa" name="chuyenKhoaId" class="form-select">
                        <option value="">Tất cả chuyên khoa</option>
                        @foreach (var ck in Model.ChuyenKhoas)
                        {
                            <option value="@ck.Id">@ck.Name (@ck.SoBacSi bác sĩ)</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label for="quickBacSi" class="form-label fw-semibold small text-muted mb-1">
                        <i class="bi bi-person-badge me-1 text-primary" aria-hidden="true"></i>Bác sĩ
                    </label>
                    <input id="quickBacSi"
                           name="tuKhoa"
                           type="text"
                           class="form-control"
                           list="pkDoctorSuggestions"
                           placeholder="Nhập tên bác sĩ hoặc học vị..."
                           autocomplete="off" />
                    <datalist id="pkDoctorSuggestions">
                        @foreach (var bs in Model.GoiYBacSi)
                        {
                            <option value="@bs.FullName" data-specialty-id="@bs.SpecialtyId">@bs.DisplayName</option>
                        }
                    </datalist>
                </div>
                <div class="col-12 col-sm-6 col-md-2">
                    <label for="quickNgayKham" class="form-label fw-semibold small text-muted mb-1">
                        <i class="bi bi-calendar-event me-1 text-primary" aria-hidden="true"></i>Ngày khám
                    </label>
                    <input id="quickNgayKham"
                           name="ngayKham"
                           type="date"
                           class="form-control"
                           min="@Model.NgayMacDinh.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-sm-6 col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <span>Tìm nhanh</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- Specialties Grid -->
<section class="mb-5">
    <div class="pk-section-header mb-4">
        <div>
            <h2 class="h4 fw-bold mb-1">Chuyên khoa khám bệnh</h2>
            <p class="text-muted mb-0">Lựa chọn chuyên khoa phù hợp với nhu cầu thăm khám của bạn</p>
        </div>
        <a href="/chuyen-khoa" class="btn btn-outline-primary">
            <span>Xem tất cả chuyên khoa</span>
            <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
    </div>

    @if (Model.ChuyenKhoaNoiBat.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-hospital fs-1 d-block mb-2 opacity-50" aria-hidden="true"></i>
                <p class="mb-0">Hiện chưa có chuyên khoa nào đang hoạt động.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3 g-md-4">
            @foreach (var ck in Model.ChuyenKhoaNoiBat)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <a href="/bac-si?chuyenKhoaId=@ck.Id" class="card pk-specialty-card h-100 text-decoration-none text-reset">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                                <div class="pk-specialty-icon" aria-hidden="true">
                                    <i class="bi bi-heart-pulse-fill"></i>
                                </div>
                                <span class="badge rounded-pill pk-badge-soft">
                                    @ck.SoBacSi bác sĩ
                                </span>
                            </div>
                            <h3 class="h5 fw-bold mb-2 text-dark">@ck.Name</h3>
                            <p class="text-muted small pk-line-clamp-2 mb-3 flex-grow-1">
                                @(string.IsNullOrWhiteSpace(ck.Description) ? "Thăm khám, tư vấn và điều trị chuyên sâu theo phác đồ chuẩn." : ck.Description)
                            </p>
                            <div class="text-primary fw-semibold small d-inline-flex align-items-center gap-1 mt-auto">
                                <span>Xem bác sĩ chuyên khoa</span>
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</section>

<!-- Featured Doctors -->
<section class="mb-5">
    <div class="pk-section-header mb-4">
        <div>
            <h2 class="h4 fw-bold mb-1">Đội ngũ bác sĩ nổi bật</h2>
            <p class="text-muted mb-0">Các bác sĩ giàu kinh nghiệm và nhận được đánh giá tích cực từ bệnh nhân</p>
        </div>
        <a href="/bac-si" class="btn btn-outline-primary">
            <span>Xem tất cả bác sĩ</span>
            <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
    </div>

    @if (Model.BacSiNoiBat.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-person-badge fs-1 d-block mb-2 opacity-50" aria-hidden="true"></i>
                <p class="mb-0">Hiện chưa có thông tin bác sĩ trên hệ thống.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3 g-md-4">
            @foreach (var doctor in Model.BacSiNoiBat)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <partial name="_DoctorCardPartial" model="doctor" />
                </div>
            }
        </div>
    }
</section>

<!-- 3-Step Process -->
<section class="mb-4">
    <div class="text-center mb-4">
        <span class="badge rounded-pill pk-badge-teal mb-2">Đơn giản &amp; minh bạch</span>
        <h2 class="h4 fw-bold mb-2">Quy trình đặt lịch khám 3 bước</h2>
        <p class="text-muted mb-0">Chỉ mất chưa đầy 2 phút để hoàn tất đặt lịch khám tại phòng khám</p>
    </div>

    <div class="row g-3 g-md-4">
        <div class="col-12 col-md-4">
            <div class="card pk-step-card h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="pk-step-number">01</span>
                        <div class="pk-step-icon" aria-hidden="true">
                            <i class="bi bi-search-heart"></i>
                        </div>
                    </div>
                    <h3 class="h5 fw-bold mb-2">Chọn chuyên khoa &amp; bác sĩ</h3>
                    <p class="text-muted small mb-0">
                        Tra cứu chuyên khoa, xem hồ sơ bác sĩ, phí khám và đánh giá từ các bệnh nhân đã thăm khám.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card pk-step-card h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="pk-step-number">02</span>
                        <div class="pk-step-icon" aria-hidden="true">
                            <i class="bi bi-calendar2-check"></i>
                        </div>
                    </div>
                    <h3 class="h5 fw-bold mb-2">Chọn ngày &amp; khung giờ</h3>
                    <p class="text-muted small mb-0">
                        Chọn khung giờ còn trống theo lịch làm việc thực tế của bác sĩ, nhập lý do khám và gửi yêu cầu đặt lịch.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card pk-step-card h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="pk-step-number">03</span>
                        <div class="pk-step-icon" aria-hidden="true">
                            <i class="bi bi-file-earmark-medical"></i>
                        </div>
                    </div>
                    <h3 class="h5 fw-bold mb-2">Đến khám &amp; xem hồ sơ</h3>
                    <p class="text-muted small mb-0">
                        Check-in nhanh tại quầy lễ tân để nhận số thứ tự, sau khám có thể xem đơn thuốc, kết quả và hóa đơn trực tuyến.
                    </p>
                </div>
            </div>
        </div>
    </div>

    @if (!isAuthenticated || isPatient)
    {
        <div class="card pk-cta-banner mt-4">
            <div class="card-body p-4 p-md-5 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <h3 class="h5 fw-bold mb-1 text-dark">Bạn cần đặt lịch khám trong thời gian tới?</h3>
                    <p class="text-muted mb-0">Đặt lịch trực tuyến ngay hôm nay để chủ động thời gian và được phục vụ chu đáo nhất.</p>
                </div>
                <div class="flex-shrink-0">
                    <a href="@datLichHref" class="btn btn-primary px-4 w-100 w-md-auto">
                        <i class="bi bi-calendar-plus" aria-hidden="true"></i>
                        <span>Đặt lịch khám ngay</span>
                    </a>
                </div>
            </div>
        </div>
    }
</section>
