@model PhongKham.Web.ViewModels.Public.BangGiaIndexViewModel
@{
    ViewData["Title"] = "Bảng giá dịch vụ";
    var danhSach = Model.DanhSachDichVu;
    var loaiDichVus = Enum.GetValues<LoaiDichVu>();

    string BuildUrl(LoaiDichVu? loai, string? tuKhoa, int targetPage = 1)
    {
        var query = new List<string>();
        if (loai.HasValue)
        {
            query.Add($"loaiDichVu={loai.Value}");
        }
        if (!string.IsNullOrWhiteSpace(tuKhoa))
        {
            query.Add($"tuKhoa={Uri.EscapeDataString(tuKhoa)}");
        }
        if (targetPage > 1)
        {
            query.Add($"page={targetPage}");
        }

        return query.Count == 0 ? "/bang-gia" : $"/bang-gia?{string.Join("&", query)}";
    }

    string BadgeClassForLoai(LoaiDichVu loai) => loai switch
    {
        LoaiDichVu.Kham => "pk-badge-soft",
        LoaiDichVu.XetNghiem => "pk-badge-teal",
        LoaiDichVu.ChanDoanHinhAnh => "pk-badge-purple",
        LoaiDichVu.ThuThuat => "pk-badge-warning",
        _ => "pk-badge-soft"
    };
}

<nav aria-label="Breadcrumb" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">Bảng giá</li>
    </ol>
</nav>

<div class="pk-page-header mb-4">
    <h1 class="h3 fw-bold mb-1">Bảng giá dịch vụ y tế</h1>
    <p class="text-muted mb-0">
        Niêm yết công khai, minh bạch theo danh mục dịch vụ đang áp dụng tại Phòng Khám Đa Khoa.
    </p>
</div>

<!-- Filter & Search Card -->
<div class="card mb-4">
    <div class="card-body p-3 p-md-4">
        <div class="pk-filter-pills d-flex flex-wrap gap-2 mb-3" role="tablist" aria-label="Lọc theo loại dịch vụ">
            <a href="@BuildUrl(null, Model.TuKhoa)"
               class="btn @(Model.LoaiDichVu is null ? "btn-primary" : "btn-outline-primary")">
                Tất cả dịch vụ
            </a>
            @foreach (var loai in loaiDichVus)
            {
                <a href="@BuildUrl(loai, Model.TuKhoa)"
                   class="btn @(Model.LoaiDichVu == loai ? "btn-primary" : "btn-outline-primary")">
                    @EnumDisplayHelper.TenLoaiDichVu(loai)
                </a>
            }
        </div>

        <form method="get" action="/bang-gia" class="row g-2 align-items-center">
            @if (Model.LoaiDichVu.HasValue)
            {
                <input type="hidden" name="loaiDichVu" value="@Model.LoaiDichVu.Value" />
            }
            <div class="col-12 col-md">
                <input type="search"
                       name="tuKhoa"
                       value="@Model.TuKhoa"
                       class="form-control"
                       placeholder="Tìm theo mã dịch vụ, tên dịch vụ hoặc mô tả..."
                       aria-label="Tìm kiếm dịch vụ" />
            </div>
            <div class="col-12 col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1 flex-md-grow-0">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <span>Tìm kiếm</span>
                </button>
                @if (Model.CoBoLoc)
                {
                    <a href="/bang-gia" class="btn btn-secondary flex-shrink-0">
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                        <span>Đặt lại</span>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Results Summary -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 small text-muted">
    @if (danhSach.TotalCount > 0)
    {
        <span>
            Hiển thị <strong class="text-dark">@danhSach.StartItem–@danhSach.EndItem</strong>
            trên tổng số <strong class="text-dark">@danhSach.TotalCount</strong> dịch vụ
        </span>
    }
    else
    {
        <span>Không tìm thấy dịch vụ phù hợp</span>
    }
    <span>Đơn vị tính: Việt Nam Đồng (đ)</span>
</div>

@if (danhSach.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-tags fs-1 text-muted opacity-50 d-block mb-3" aria-hidden="true"></i>
            <h2 class="h5 fw-bold mb-2">Không có dịch vụ nào phù hợp</h2>
            <p class="text-muted mb-3">Vui lòng thử từ khóa hoặc danh mục dịch vụ khác.</p>
            @if (Model.CoBoLoc)
            {
                <a href="/bang-gia" class="btn btn-outline-primary">Xem toàn bộ bảng giá</a>
            }
        </div>
    </div>
}
else
{
    <!-- Desktop Table -->
    <div class="card d-none d-md-block">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 pk-price-table">
                <thead>
                    <tr>
                        <th scope="col" style="width: 130px;">Mã DV</th>
                        <th scope="col">Tên dịch vụ</th>
                        <th scope="col" style="width: 190px;">Phân loại</th>
                        <th scope="col" class="text-end" style="width: 170px;">Đơn giá</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in danhSach.Items)
                    {
                        <tr>
                            <td>
                                <span class="font-monospace small fw-semibold text-muted">@item.MaDichVu</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@item.TenDichVu</div>
                                @if (!string.IsNullOrWhiteSpace(item.MoTa))
                                {
                                    <div class="small text-muted mt-1">@item.MoTa</div>
                                }
                            </td>
                            <td>
                                <span class="badge rounded-pill @BadgeClassForLoai(item.LoaiDichVu)">
                                    @item.TenLoaiDichVu
                                </span>
                            </td>
                            <td class="text-end fw-bold text-primary text-nowrap">
                                @item.DonGia.ToString("N0") đ
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile Card List (optimized for 390px) -->
    <div class="d-md-none d-flex flex-column gap-3">
        @foreach (var item in danhSach.Items)
        {
            <article class="card">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                        <span class="font-monospace small fw-semibold text-muted">@item.MaDichVu</span>
                        <span class="badge rounded-pill @BadgeClassForLoai(item.LoaiDichVu)">
                            @item.TenLoaiDichVu
                        </span>
                    </div>
                    <h2 class="h6 fw-bold text-dark mb-1">@item.TenDichVu</h2>
                    @if (!string.IsNullOrWhiteSpace(item.MoTa))
                    {
                        <p class="small text-muted mb-2">@item.MoTa</p>
                    }
                    <div class="pt-2 mt-2 border-top d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Đơn giá</span>
                        <span class="fw-bold text-primary">@item.DonGia.ToString("N0") đ</span>
                    </div>
                </div>
            </article>
        }
    </div>

    @if (danhSach.TotalPages > 1)
    {
        <nav aria-label="Phân trang bảng giá dịch vụ" class="mt-4">
            <ul class="pagination justify-content-center flex-wrap gap-1 mb-0">
                <li class="page-item @(danhSach.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" href="@(danhSach.HasPreviousPage ? BuildUrl(Model.LoaiDichVu, Model.TuKhoa, danhSach.PageIndex - 1) : "#")" aria-label="Trang trước">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </a>
                </li>
                @for (var i = 1; i <= danhSach.TotalPages; i++)
                {
                    <li class="page-item @(i == danhSach.PageIndex ? "active" : "")">
                        <a class="page-link" href="@BuildUrl(Model.LoaiDichVu, Model.TuKhoa, i)">@i</a>
                    </li>
                }
                <li class="page-item @(danhSach.HasNextPage ? "" : "disabled")">
                    <a class="page-link" href="@(danhSach.HasNextPage ? BuildUrl(Model.LoaiDichVu, Model.TuKhoa, danhSach.PageIndex + 1) : "#")" aria-label="Trang sau">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}

<div class="alert alert-light border mt-4 mb-0 d-flex align-items-start gap-2 small text-muted" role="note">
    <i class="bi bi-info-circle text-primary fs-5 flex-shrink-0" aria-hidden="true"></i>
    <div>
        Bảng giá trên áp dụng cho các dịch vụ hiện hành của phòng khám. Phí khám trực tiếp theo từng bác sĩ được hiển thị rõ ràng trong mục
        <a href="/bac-si" class="fw-semibold text-decoration-none">Đội ngũ bác sĩ</a>.
    </div>
</div>
