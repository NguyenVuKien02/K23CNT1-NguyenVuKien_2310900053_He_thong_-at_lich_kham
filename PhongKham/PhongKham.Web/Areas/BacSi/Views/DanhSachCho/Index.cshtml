@{
    ViewData["Title"] = "Danh sách chờ khám";
}

<div class="card">
    <div class="card-body p-4">
        <h2 class="h5 fw-bold mb-2">Chào mừng đến Khu vực Bác sĩ</h2>
        <p class="text-muted mb-0">
            Bạn đang đăng nhập với tài khoản <strong>@User.Identity?.Name</strong> (Bác sĩ).
            Danh sách chờ khám sẽ được hoàn thiện ở bước tiếp theo.
        </p>
    </div>
</div>
