@model NhanVienAdminIndexViewModel
@{
    ViewData["Title"] = "Quản lý nhân viên lễ tân";
    var ds = Model.DanhSach;
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1">Nhân viên lễ tân</h2>
        <p class="text-muted small mb-0">Quản lý hồ sơ và tài khoản nhân viên lễ tân (vai trò Lễ tân).</p>
    </div>
    <a asp-area="Admin" asp-controller="NhanVien" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus" aria-hidden="true"></i>
        <span>Thêm nhân viên</span>
    </a>
</div>

<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-area="Admin" asp-controller="NhanVien" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md">
                <input type="search" name="tuKhoa" value="@Model.TuKhoa" class="form-control"
                       placeholder="Tìm theo họ tên, email, SĐT, chức vụ..." aria-label="Tìm kiếm nhân viên" />
            </div>
            <div class="col-12 col-md-3">
                <select name="trangThai" class="form-select" aria-label="Lọc theo trạng thái">
                    <option value="">Tất cả trạng thái</option>
                    <option value="true" selected="@(Model.TrangThai == true)">Đang hoạt động</option>
                    <option value="false" selected="@(Model.TrangThai == false)">Ngừng hoạt động</option>
                </select>
            </div>
            <div class="col-12 col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1 flex-md-grow-0">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <span>Tìm kiếm</span>
                </button>
                @if (Model.CoBoLoc)
                {
                    <a asp-area="Admin" asp-controller="NhanVien" asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                        <span>Đặt lại</span>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Danh sách nhân viên</span>
        <span class="small text-muted">Tổng: <strong class="text-dark">@ds.TotalCount</strong> nhân viên</span>
    </div>
    @if (ds.Items.Count == 0)
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-person-vcard fs-1 text-muted opacity-50 d-block mb-2" aria-hidden="true"></i>
            <p class="text-muted mb-0">Không có nhân viên nào phù hợp.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 pk-price-table">
                <thead>
                    <tr>
                        <th>Nhân viên</th>
                        <th>Chức vụ</th>
                        <th style="width: 110px;">Giới tính</th>
                        <th>Liên hệ</th>
                        <th style="width: 130px;">Ngày vào làm</th>
                        <th style="width: 150px;">Trạng thái</th>
                        <th class="text-end" style="width: 210px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ds.Items)
                    {
                        <tr>
                            <td class="fw-semibold text-dark">@item.FullName</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Position) ? "Lễ tân" : item.Position)</td>
                            <td>@item.TenGioiTinh</td>
                            <td>
                                <div class="small text-dark">@item.Email</div>
                                <div class="small text-muted">@(string.IsNullOrWhiteSpace(item.Phone) ? "Chưa có SĐT" : item.Phone)</div>
                            </td>
                            <td class="text-nowrap">@(item.HireDate.HasValue ? item.HireDate.Value.ToString("dd/MM/yyyy") : "—")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge rounded-pill text-bg-success">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary">Ngừng hoạt động</span>
                                }
                                @if (!item.UserIsActive && item.IsActive)
                                {
                                    <div class="small text-danger mt-1"><i class="bi bi-lock-fill" aria-hidden="true"></i> Tài khoản bị khóa</div>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-area="Admin" asp-controller="NhanVien" asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                        <span>Sửa</span>
                                    </a>
                                    <form method="post" asp-area="Admin" asp-controller="NhanVien" asp-action="DoiTrangThai" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="isActive" value="@(item.IsActive ? "false" : "true")" />
                                        <input type="hidden" name="tuKhoa" value="@Model.TuKhoa" />
                                        <input type="hidden" name="trangThai" value="@(Model.TrangThai.HasValue ? (Model.TrangThai.Value ? "true" : "false") : "")" />
                                        <input type="hidden" name="page" value="@ds.PageIndex" />
                                        @if (item.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    data-confirm="Ngừng hoạt động nhân viên '@item.FullName' và khóa tài khoản đăng nhập tương ứng?"
                                                    data-confirm-title="Ngừng hoạt động nhân viên"
                                                    data-confirm-btn="Ngừng hoạt động"
                                                    data-confirm-variant="danger">
                                                <i class="bi bi-slash-circle" aria-hidden="true"></i>
                                                <span>Ngừng</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-success"
                                                    data-confirm="Kích hoạt lại nhân viên '@item.FullName' và mở khóa tài khoản đăng nhập?"
                                                    data-confirm-title="Kích hoạt nhân viên"
                                                    data-confirm-btn="Kích hoạt"
                                                    data-confirm-variant="success">
                                                <i class="bi bi-check-circle" aria-hidden="true"></i>
                                                <span>Kích hoạt</span>
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_AdminPaginationPartial" model="@(new AdminPaginationViewModel
{
    PageIndex = ds.PageIndex,
    TotalPages = ds.TotalPages,
    TotalCount = ds.TotalCount,
    StartItem = ds.StartItem,
    EndItem = ds.EndItem,
    ItemLabel = "nhân viên",
    Controller = "NhanVien",
    RouteValues = new Dictionary<string, string?>
    {
        ["tuKhoa"] = Model.TuKhoa,
        ["trangThai"] = Model.TrangThai?.ToString()
    }
})" />
