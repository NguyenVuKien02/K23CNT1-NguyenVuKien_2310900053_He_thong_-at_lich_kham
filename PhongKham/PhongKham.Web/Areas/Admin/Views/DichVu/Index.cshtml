@model DichVuAdminIndexViewModel
@{
    ViewData["Title"] = "Quản lý dịch vụ";
    var ds = Model.DanhSach;
    var loaiDichVus = Enum.GetValues<LoaiDichVu>();

    string BadgeClassForLoai(LoaiDichVu loai) => loai switch
    {
        LoaiDichVu.Kham => "pk-badge-soft",
        LoaiDichVu.XetNghiem => "pk-badge-teal",
        LoaiDichVu.ChanDoanHinhAnh => "pk-badge-purple",
        LoaiDichVu.ThuThuat => "pk-badge-warning",
        _ => "pk-badge-soft"
    };
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1">Danh mục dịch vụ y tế</h2>
        <p class="text-muted small mb-0">Quản lý danh mục dịch vụ khám, xét nghiệm, chẩn đoán hình ảnh và thủ thuật.</p>
    </div>
    <a asp-area="Admin" asp-controller="DichVu" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span>Thêm dịch vụ</span>
    </a>
</div>

<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-area="Admin" asp-controller="DichVu" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md">
                <input type="search" name="tuKhoa" value="@Model.TuKhoa" class="form-control"
                       placeholder="Tìm theo mã, tên dịch vụ hoặc mô tả..." aria-label="Tìm kiếm dịch vụ" />
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <select name="loaiDichVu" class="form-select" aria-label="Lọc theo loại dịch vụ">
                    <option value="">Tất cả loại dịch vụ</option>
                    @foreach (var loai in loaiDichVus)
                    {
                        <option value="@loai" selected="@(Model.LoaiDichVu == loai)">@EnumDisplayHelper.TenLoaiDichVu(loai)</option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <select name="conHieuLuc" class="form-select" aria-label="Lọc theo hiệu lực">
                    <option value="">Tất cả trạng thái</option>
                    <option value="true" selected="@(Model.ConHieuLuc == true)">Còn hiệu lực</option>
                    <option value="false" selected="@(Model.ConHieuLuc == false)">Ngừng áp dụng</option>
                </select>
            </div>
            <div class="col-12 col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1 flex-md-grow-0">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <span>Tìm kiếm</span>
                </button>
                @if (Model.CoBoLoc)
                {
                    <a asp-area="Admin" asp-controller="DichVu" asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                        <span>Đặt lại</span>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Danh sách dịch vụ</span>
        <span class="small text-muted">Tổng: <strong class="text-dark">@ds.TotalCount</strong> dịch vụ</span>
    </div>
    @if (ds.Items.Count == 0)
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-heart-pulse fs-1 text-muted opacity-50 d-block mb-2" aria-hidden="true"></i>
            <p class="text-muted mb-0">Không có dịch vụ nào phù hợp.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 pk-price-table">
                <thead>
                    <tr>
                        <th style="width: 120px;">Mã DV</th>
                        <th>Tên dịch vụ</th>
                        <th style="width: 180px;">Phân loại</th>
                        <th class="text-end" style="width: 140px;">Đơn giá</th>
                        <th style="width: 140px;">Hiệu lực</th>
                        <th class="text-end" style="width: 210px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ds.Items)
                    {
                        <tr>
                            <td class="font-monospace small fw-semibold text-muted">@item.MaDichVu</td>
                            <td>
                                <div class="fw-semibold text-dark">@item.TenDichVu</div>
                                @if (!string.IsNullOrWhiteSpace(item.MoTa))
                                {
                                    <div class="small text-muted">@item.MoTa</div>
                                }
                            </td>
                            <td>
                                <span class="badge rounded-pill @BadgeClassForLoai(item.LoaiDichVu)">
                                    @item.TenLoaiDichVu
                                </span>
                            </td>
                            <td class="text-end fw-semibold text-primary text-nowrap">@item.DonGia.ToString("N0") đ</td>
                            <td>
                                @if (item.ConHieuLuc)
                                {
                                    <span class="badge rounded-pill text-bg-success">Còn hiệu lực</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary">Ngừng áp dụng</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-area="Admin" asp-controller="DichVu" asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                        <span>Sửa</span>
                                    </a>
                                    <form method="post" asp-area="Admin" asp-controller="DichVu" asp-action="DoiTrangThai" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="conHieuLuc" value="@(item.ConHieuLuc ? "false" : "true")" />
                                        <input type="hidden" name="tuKhoa" value="@Model.TuKhoa" />
                                        <input type="hidden" name="loaiDichVu" value="@Model.LoaiDichVu" />
                                        <input type="hidden" name="conHieuLucFilter" value="@(Model.ConHieuLuc.HasValue ? (Model.ConHieuLuc.Value ? "true" : "false") : "")" />
                                        <input type="hidden" name="page" value="@ds.PageIndex" />
                                        @if (item.ConHieuLuc)
                                        {
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    data-confirm="Bạn có chắc chắn muốn ngừng áp dụng dịch vụ '@item.TenDichVu'?"
                                                    data-confirm-title="Ngừng áp dụng dịch vụ"
                                                    data-confirm-btn="Ngừng áp dụng"
                                                    data-confirm-variant="danger">
                                                <i class="bi bi-slash-circle" aria-hidden="true"></i>
                                                <span>Ngừng</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-success"
                                                    data-confirm="Kích hoạt lại dịch vụ '@item.TenDichVu'?"
                                                    data-confirm-title="Kích hoạt dịch vụ"
                                                    data-confirm-btn="Kích hoạt"
                                                    data-confirm-variant="success">
                                                <i class="bi bi-check-circle" aria-hidden="true"></i>
                                                <span>Kích hoạt</span>
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_AdminPaginationPartial" model="@(new AdminPaginationViewModel
{
    PageIndex = ds.PageIndex,
    TotalPages = ds.TotalPages,
    TotalCount = ds.TotalCount,
    StartItem = ds.StartItem,
    EndItem = ds.EndItem,
    ItemLabel = "dịch vụ",
    Controller = "DichVu",
    RouteValues = new Dictionary<string, string?>
    {
        ["tuKhoa"] = Model.TuKhoa,
        ["loaiDichVu"] = Model.LoaiDichVu?.ToString(),
        ["conHieuLuc"] = Model.ConHieuLuc?.ToString()
    }
})" />
