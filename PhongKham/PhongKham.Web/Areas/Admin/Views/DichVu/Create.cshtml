@model DichVuFormViewModel
@{
    ViewData["Title"] = "Thêm dịch vụ";
    var loaiDichVus = Enum.GetValues<LoaiDichVu>();
}

<div class="mb-3">
    <a asp-area="Admin" asp-controller="DichVu" asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        <span>Quay lại danh sách</span>
    </a>
</div>

<div class="card" style="max-width: 780px;">
    <div class="card-header bg-white py-3">
        <h2 class="h5 fw-bold mb-0">Thêm dịch vụ mới</h2>
    </div>
    <div class="card-body p-4">
        <form method="post" asp-area="Admin" asp-controller="DichVu" asp-action="Create" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label asp-for="MaDichVu" class="form-label fw-medium"></label>
                    <input asp-for="MaDichVu" class="form-control text-uppercase" placeholder="Để trống để tự sinh" />
                    <div class="form-text">Để trống hệ thống tự sinh dạng DV000001.</div>
                    <span asp-validation-for="MaDichVu" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-8">
                    <label asp-for="TenDichVu" class="form-label fw-medium"></label>
                    <span class="text-danger">*</span>
                    <input asp-for="TenDichVu" class="form-control" placeholder="Ví dụ: Xét nghiệm công thức máu" />
                    <span asp-validation-for="TenDichVu" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="LoaiDichVu" class="form-label fw-medium"></label>
                    <span class="text-danger">*</span>
                    <select asp-for="LoaiDichVu" class="form-select">
                        @foreach (var loai in loaiDichVus)
                        {
                            <option value="@loai">@EnumDisplayHelper.TenLoaiDichVu(loai)</option>
                        }
                    </select>
                    <span asp-validation-for="LoaiDichVu" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="DonGia" class="form-label fw-medium"></label>
                    <span class="text-danger">*</span>
                    <input asp-for="DonGia" asp-format="{0:0}" type="number" min="0" step="1000" class="form-control" />
                    <span asp-validation-for="DonGia" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="MoTa" class="form-label fw-medium"></label>
                    <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Mô tả chi tiết dịch vụ..."></textarea>
                    <span asp-validation-for="MoTa" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="ConHieuLuc" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="ConHieuLuc" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    <span>Lưu dịch vụ</span>
                </button>
                <a asp-area="Admin" asp-controller="DichVu" asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
