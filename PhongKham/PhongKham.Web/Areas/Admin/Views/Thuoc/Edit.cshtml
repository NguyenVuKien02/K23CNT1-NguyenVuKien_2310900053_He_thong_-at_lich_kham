@model ThuocFormViewModel
@{
    ViewData["Title"] = "Cập nhật thuốc";
}

<div class="mb-3">
    <a asp-area="Admin" asp-controller="Thuoc" asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        <span>Quay lại danh sách</span>
    </a>
</div>

<div class="card" style="max-width: 820px;">
    <div class="card-header bg-white py-3">
        <h2 class="h5 fw-bold mb-0">Cập nhật thông tin thuốc</h2>
    </div>
    <div class="card-body p-4">
        <form method="post" asp-area="Admin" asp-controller="Thuoc" asp-action="Edit" novalidate>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-12 col-md-7">
                    <label asp-for="Name" class="form-label fw-medium"></label>
                    <span class="text-danger">*</span>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-5">
                    <label asp-for="MedicineCategoryId" class="form-label fw-medium"></label>
                    <span class="text-danger">*</span>
                    <select asp-for="MedicineCategoryId" asp-items="Model.NhomThuocOptions" class="form-select">
                        <option value="">-- Chọn nhóm thuốc --</option>
                    </select>
                    <span asp-validation-for="MedicineCategoryId" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="ActiveIngredient" class="form-label fw-medium"></label>
                    <input asp-for="ActiveIngredient" class="form-control" />
                    <span asp-validation-for="ActiveIngredient" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Manufacturer" class="form-label fw-medium"></label>
                    <input asp-for="Manufacturer" class="form-control" />
                    <span asp-validation-for="Manufacturer" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Unit" class="form-label fw-medium"></label>
                    <span class="text-danger">*</span>
                    <input asp-for="Unit" class="form-control" />
                    <span asp-validation-for="Unit" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="Price" class="form-label fw-medium"></label>
                    <span class="text-danger">*</span>
                    <input asp-for="Price" asp-format="{0:0}" type="number" min="0" step="100" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="StockQuantity" class="form-label fw-medium"></label>
                    <span class="text-danger">*</span>
                    <input asp-for="StockQuantity" type="number" min="0" step="1" class="form-control" />
                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch mt-2">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    <span>Lưu thay đổi</span>
                </button>
                <a asp-area="Admin" asp-controller="Thuoc" asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
