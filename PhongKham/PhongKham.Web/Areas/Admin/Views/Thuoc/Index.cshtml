@model ThuocAdminIndexViewModel
@{
    ViewData["Title"] = "Quản lý thuốc";
    var ds = Model.DanhSach;
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1">Danh mục thuốc & tồn kho</h2>
        <p class="text-muted small mb-0">Quản lý thông tin thuốc, đơn giá bán và số lượng tồn kho.</p>
    </div>
    <a asp-area="Admin" asp-controller="Thuoc" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span>Thêm thuốc</span>
    </a>
</div>

<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-area="Admin" asp-controller="Thuoc" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-lg-4">
                <input type="search" name="tuKhoa" value="@Model.TuKhoa" class="form-control"
                       placeholder="Tìm theo tên thuốc, hoạt chất, hãng SX..." aria-label="Tìm kiếm thuốc" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <select name="medicineCategoryId" class="form-select" aria-label="Lọc theo nhóm thuốc">
                    <option value="">Tất cả nhóm thuốc</option>
                    @foreach (var opt in Model.NhomThuocOptions)
                    {
                        <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                    }
                </select>
            </div>
            <div class="col-6 col-sm-3 col-lg-2">
                <select name="trangThaiTonKho" class="form-select" aria-label="Lọc theo tồn kho">
                    <option value="">Tất cả tồn kho</option>
                    <option value="het" selected="@(Model.TrangThaiTonKho == "het")">Hết hàng (0)</option>
                    <option value="sap-het" selected="@(Model.TrangThaiTonKho == "sap-het")">Sắp hết (1–10)</option>
                    <option value="con" selected="@(Model.TrangThaiTonKho == "con")">Còn nhiều (&gt; 10)</option>
                </select>
            </div>
            <div class="col-6 col-sm-3 col-lg-2">
                <select name="trangThai" class="form-select" aria-label="Lọc theo trạng thái">
                    <option value="">Tất cả trạng thái</option>
                    <option value="true" selected="@(Model.TrangThai == true)">Đang sử dụng</option>
                    <option value="false" selected="@(Model.TrangThai == false)">Ngừng sử dụng</option>
                </select>
            </div>
            <div class="col-12 col-lg-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1 flex-lg-grow-0">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <span>Lọc</span>
                </button>
                @if (Model.CoBoLoc)
                {
                    <a asp-area="Admin" asp-controller="Thuoc" asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                        <span>Đặt lại</span>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Danh sách thuốc</span>
        <span class="small text-muted">Tổng: <strong class="text-dark">@ds.TotalCount</strong> loại thuốc</span>
    </div>
    @if (ds.Items.Count == 0)
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-capsule fs-1 text-muted opacity-50 d-block mb-2" aria-hidden="true"></i>
            <p class="text-muted mb-0">Không có thuốc nào phù hợp.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 pk-price-table">
                <thead>
                    <tr>
                        <th>Tên thuốc / Hoạt chất</th>
                        <th>Nhóm thuốc</th>
                        <th style="width: 90px;">ĐVT</th>
                        <th class="text-end" style="width: 130px;">Đơn giá</th>
                        <th class="text-center" style="width: 130px;">Tồn kho</th>
                        <th style="width: 130px;">Trạng thái</th>
                        <th class="text-end" style="width: 240px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ds.Items)
                    {
                        var stockBadgeClass = item.StockQuantity <= 0
                            ? "text-bg-danger"
                            : item.StockQuantity <= 10
                                ? "text-bg-warning"
                                : "text-bg-success";
                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">@item.Name</div>
                                @if (!string.IsNullOrWhiteSpace(item.ActiveIngredient))
                                {
                                    <div class="small text-muted">Hoạt chất: @item.ActiveIngredient</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Manufacturer))
                                {
                                    <div class="small text-muted">Hãng SX: @item.Manufacturer</div>
                                }
                            </td>
                            <td>
                                <span class="badge rounded-pill pk-badge-soft">@item.MedicineCategoryName</span>
                            </td>
                            <td>@item.Unit</td>
                            <td class="text-end fw-semibold text-primary text-nowrap">@item.Price.ToString("N0") đ</td>
                            <td class="text-center">
                                <span class="badge rounded-pill @stockBadgeClass">
                                    @item.StockQuantity.ToString("N0") @item.Unit
                                </span>
                                @if (item.StockQuantity <= 0)
                                {
                                    <div class="small text-danger fw-medium mt-1">Hết hàng</div>
                                }
                                else if (item.StockQuantity <= 10)
                                {
                                    <div class="small text-warning-emphasis fw-medium mt-1">Sắp hết</div>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge rounded-pill text-bg-success">Đang dùng</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary">Ngừng dùng</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                    <button type="button"
                                            class="btn btn-sm btn-secondary js-open-stock-modal"
                                            data-bs-toggle="modal"
                                            data-bs-target="#pkStockModal"
                                            data-id="@item.Id"
                                            data-name="@item.Name"
                                            data-unit="@item.Unit"
                                            data-stock="@item.StockQuantity"
                                            title="Cập nhật tồn kho">
                                        <i class="bi bi-box-seam" aria-hidden="true"></i>
                                        <span>Kho</span>
                                    </button>
                                    <a asp-area="Admin" asp-controller="Thuoc" asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                        <span>Sửa</span>
                                    </a>
                                    <form method="post" asp-area="Admin" asp-controller="Thuoc" asp-action="DoiTrangThai" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="isActive" value="@(item.IsActive ? "false" : "true")" />
                                        <input type="hidden" name="tuKhoa" value="@Model.TuKhoa" />
                                        <input type="hidden" name="medicineCategoryId" value="@Model.MedicineCategoryId" />
                                        <input type="hidden" name="trangThai" value="@(Model.TrangThai.HasValue ? (Model.TrangThai.Value ? "true" : "false") : "")" />
                                        <input type="hidden" name="trangThaiTonKho" value="@Model.TrangThaiTonKho" />
                                        <input type="hidden" name="page" value="@ds.PageIndex" />
                                        @if (item.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    data-confirm="Bạn có chắc chắn muốn ngừng sử dụng thuốc '@item.Name'?"
                                                    data-confirm-title="Ngừng sử dụng thuốc"
                                                    data-confirm-btn="Ngừng sử dụng"
                                                    data-confirm-variant="danger">
                                                <i class="bi bi-slash-circle" aria-hidden="true"></i>
                                                <span>Ngừng</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-success"
                                                    data-confirm="Kích hoạt lại thuốc '@item.Name'?"
                                                    data-confirm-title="Kích hoạt thuốc"
                                                    data-confirm-btn="Kích hoạt"
                                                    data-confirm-variant="success">
                                                <i class="bi bi-check-circle" aria-hidden="true"></i>
                                                <span>Kích hoạt</span>
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_AdminPaginationPartial" model="@(new AdminPaginationViewModel
{
    PageIndex = ds.PageIndex,
    TotalPages = ds.TotalPages,
    TotalCount = ds.TotalCount,
    StartItem = ds.StartItem,
    EndItem = ds.EndItem,
    ItemLabel = "loại thuốc",
    Controller = "Thuoc",
    RouteValues = new Dictionary<string, string?>
    {
        ["tuKhoa"] = Model.TuKhoa,
        ["medicineCategoryId"] = Model.MedicineCategoryId?.ToString(),
        ["trangThai"] = Model.TrangThai?.ToString(),
        ["trangThaiTonKho"] = Model.TrangThaiTonKho
    }
})" />

<!-- Quick Stock Update Modal -->
<div class="modal fade" id="pkStockModal" tabindex="-1" aria-labelledby="pkStockModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-area="Admin" asp-controller="Thuoc" asp-action="CapNhatTonKho">
                <div class="modal-header">
                    <h5 class="modal-title fw-semibold" id="pkStockModalTitle">Cập nhật số lượng tồn kho</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="pkStockMedicineId" />
                    <input type="hidden" name="tuKhoa" value="@Model.TuKhoa" />
                    <input type="hidden" name="medicineCategoryId" value="@Model.MedicineCategoryId" />
                    <input type="hidden" name="trangThai" value="@(Model.TrangThai.HasValue ? (Model.TrangThai.Value ? "true" : "false") : "")" />
                    <input type="hidden" name="trangThaiTonKho" value="@Model.TrangThaiTonKho" />
                    <input type="hidden" name="page" value="@ds.PageIndex" />

                    <p class="mb-3">Thuốc: <strong id="pkStockMedicineName"></strong></p>
                    <div class="mb-2">
                        <label for="pkStockQuantityInput" class="form-label fw-medium">Số lượng tồn kho mới (<span id="pkStockMedicineUnit"></span>)</label>
                        <input type="number" min="0" max="10000000" required class="form-control" id="pkStockQuantityInput" name="stockQuantity" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu tồn kho</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('.js-open-stock-modal').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.getElementById('pkStockMedicineId').value = btn.dataset.id || '';
                    document.getElementById('pkStockMedicineName').textContent = btn.dataset.name || '';
                    document.getElementById('pkStockMedicineUnit').textContent = btn.dataset.unit || '';
                    document.getElementById('pkStockQuantityInput').value = btn.dataset.stock || '0';
                });
            });
        })();
    </script>
}
