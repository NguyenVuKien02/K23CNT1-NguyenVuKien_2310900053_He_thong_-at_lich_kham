@model AdminPaginationViewModel
@{
    string PageUrl(int page)
    {
        var routeValues = new Dictionary<string, string?>(Model.RouteValues)
        {
            ["area"] = "Admin",
            ["page"] = page.ToString()
        };
        return Url.Action(Model.Action, Model.Controller, routeValues) ?? "#";
    }
}

@if (Model.TotalPages > 1)
{
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 mt-3">
        <div class="small text-muted">
            Hiển thị <strong class="text-dark">@Model.StartItem–@Model.EndItem</strong>
            trên tổng số <strong class="text-dark">@Model.TotalCount</strong> @Model.ItemLabel
        </div>
        <nav aria-label="Phân trang danh sách @Model.ItemLabel">
            <ul class="pagination pagination-sm flex-wrap gap-1 mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" href="@(Model.HasPreviousPage ? PageUrl(Model.PageIndex - 1) : "#")" aria-label="Trang trước">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </a>
                </li>
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == 1 || i == Model.TotalPages || (i >= Model.PageIndex - 2 && i <= Model.PageIndex + 2))
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link" href="@PageUrl(i)">@i</a>
                        </li>
                    }
                    else if (i == Model.PageIndex - 3 || i == Model.PageIndex + 3)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" href="@(Model.HasNextPage ? PageUrl(Model.PageIndex + 1) : "#")" aria-label="Trang sau">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}
