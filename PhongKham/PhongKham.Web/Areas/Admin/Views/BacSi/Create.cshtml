@model BacSiCreateViewModel
@{
    ViewData["Title"] = "Thêm bác sĩ";
}

<div class="mb-3">
    <a asp-area="Admin" asp-controller="BacSi" asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        <span>Quay lại danh sách</span>
    </a>
</div>

<div class="card" style="max-width: 920px;">
    <div class="card-header bg-white py-3">
        <h2 class="h5 fw-bold mb-0">Thêm bác sĩ mới (tạo đồng thời tài khoản vai trò Bác sĩ)</h2>
    </div>
    <div class="card-body p-4">
        <form method="post" asp-area="Admin" asp-controller="BacSi" asp-action="Create" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <h3 class="h6 fw-bold text-primary mb-3">1. Thông tin tài khoản đăng nhập</h3>
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <label asp-for="Email" class="form-label fw-medium"></label>
                    <span class="text-danger">*</span>
                    <input asp-for="Email" type="email" class="form-control" placeholder="bacsi@phongkham.vn" autocomplete="off" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="Password" class="form-label fw-medium"></label>
                    <span class="text-danger">*</span>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <div class="form-text">Ít nhất 8 ký tự, gồm cả chữ và số.</div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-medium"></label>
                    <span class="text-danger">*</span>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />
            <h3 class="h6 fw-bold text-primary mb-3">2. Thông tin hồ sơ bác sĩ</h3>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="FullName" class="form-label fw-medium"></label>
                    <span class="text-danger">*</span>
                    <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="SpecialtyId" class="form-label fw-medium"></label>
                    <span class="text-danger">*</span>
                    <select asp-for="SpecialtyId" asp-items="Model.ChuyenKhoaOptions" class="form-select">
                        <option value="">-- Chọn chuyên khoa --</option>
                    </select>
                    <span asp-validation-for="SpecialtyId" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Gender" class="form-label fw-medium"></label>
                    <select asp-for="Gender" class="form-select">
                        <option value="">-- Chọn giới tính --</option>
                        <option value="@GioiTinh.Nam">Nam</option>
                        <option value="@GioiTinh.Nu">Nữ</option>
                        <option value="@GioiTinh.Khac">Khác</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="DateOfBirth" class="form-label fw-medium"></label>
                    <input asp-for="DateOfBirth" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="Phone" class="form-label fw-medium"></label>
                    <input asp-for="Phone" class="form-control" placeholder="09xxxxxxxx" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Degree" class="form-label fw-medium"></label>
                    <input asp-for="Degree" class="form-control" placeholder="ThS.BS, BS.CKI..." />
                    <span asp-validation-for="Degree" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="ExperienceYears" class="form-label fw-medium"></label>
                    <input asp-for="ExperienceYears" type="number" min="0" max="80" class="form-control" />
                    <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="ConsultationFee" class="form-label fw-medium"></label>
                    <span class="text-danger">*</span>
                    <input asp-for="ConsultationFee" asp-format="{0:0}" type="number" min="0" step="10000" class="form-control" />
                    <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="AvatarUrl" class="form-label fw-medium"></label>
                    <input asp-for="AvatarUrl" class="form-control" placeholder="/images/doctors/bs1.jpg hoặc https://..." />
                    <span asp-validation-for="AvatarUrl" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Bio" class="form-label fw-medium"></label>
                    <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Quá trình công tác, chuyên môn sâu..."></textarea>
                    <span asp-validation-for="Bio" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    <span>Tạo bác sĩ</span>
                </button>
                <a asp-area="Admin" asp-controller="BacSi" asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
