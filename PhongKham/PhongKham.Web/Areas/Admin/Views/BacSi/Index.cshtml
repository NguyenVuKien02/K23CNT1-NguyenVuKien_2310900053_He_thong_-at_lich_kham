@model BacSiAdminIndexViewModel
@{
    ViewData["Title"] = "Quản lý bác sĩ";
    var ds = Model.DanhSach;
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1">Đội ngũ bác sĩ</h2>
        <p class="text-muted small mb-0">Quản lý hồ sơ chuyên môn và tài khoản đăng nhập của bác sĩ.</p>
    </div>
    <a asp-area="Admin" asp-controller="BacSi" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus" aria-hidden="true"></i>
        <span>Thêm bác sĩ</span>
    </a>
</div>

<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-area="Admin" asp-controller="BacSi" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md">
                <input type="search" name="tuKhoa" value="@Model.TuKhoa" class="form-control"
                       placeholder="Tìm theo họ tên, email, SĐT, học vị..." aria-label="Tìm kiếm bác sĩ" />
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <select name="specialtyId" class="form-select" aria-label="Lọc theo chuyên khoa">
                    <option value="">Tất cả chuyên khoa</option>
                    @foreach (var opt in Model.ChuyenKhoaOptions)
                    {
                        <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <select name="trangThai" class="form-select" aria-label="Lọc theo trạng thái">
                    <option value="">Tất cả trạng thái</option>
                    <option value="true" selected="@(Model.TrangThai == true)">Đang hoạt động</option>
                    <option value="false" selected="@(Model.TrangThai == false)">Ngừng hoạt động</option>
                </select>
            </div>
            <div class="col-12 col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1 flex-md-grow-0">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <span>Tìm kiếm</span>
                </button>
                @if (Model.CoBoLoc)
                {
                    <a asp-area="Admin" asp-controller="BacSi" asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                        <span>Đặt lại</span>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Danh sách bác sĩ</span>
        <span class="small text-muted">Tổng: <strong class="text-dark">@ds.TotalCount</strong> bác sĩ</span>
    </div>
    @if (ds.Items.Count == 0)
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-person-badge fs-1 text-muted opacity-50 d-block mb-2" aria-hidden="true"></i>
            <p class="text-muted mb-0">Không có bác sĩ nào phù hợp.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 pk-price-table">
                <thead>
                    <tr>
                        <th>Bác sĩ</th>
                        <th>Chuyên khoa</th>
                        <th>Liên hệ</th>
                        <th class="text-end" style="width: 130px;">Phí khám</th>
                        <th style="width: 150px;">Trạng thái</th>
                        <th class="text-end" style="width: 220px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ds.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">@item.FullName</div>
                                <div class="small text-muted">
                                    @if (!string.IsNullOrWhiteSpace(item.Degree))
                                    {
                                        <span>@item.Degree</span>
                                    }
                                    @if (item.ExperienceYears.HasValue)
                                    {
                                        <span>@(!string.IsNullOrWhiteSpace(item.Degree) ? " • " : "")@item.ExperienceYears năm KN</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="badge rounded-pill pk-badge-soft">@item.SpecialtyName</span>
                            </td>
                            <td>
                                <div class="small text-dark">@item.Email</div>
                                <div class="small text-muted">@(string.IsNullOrWhiteSpace(item.Phone) ? "Chưa có SĐT" : item.Phone)</div>
                            </td>
                            <td class="text-end fw-semibold text-primary text-nowrap">@item.ConsultationFee.ToString("N0") đ</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge rounded-pill text-bg-success">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary">Ngừng hoạt động</span>
                                }
                                @if (!item.UserIsActive && item.IsActive)
                                {
                                    <div class="small text-danger mt-1"><i class="bi bi-lock-fill" aria-hidden="true"></i> Tài khoản bị khóa</div>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-area="Admin" asp-controller="BacSi" asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                        <span>Sửa</span>
                                    </a>
                                    <form method="post" asp-area="Admin" asp-controller="BacSi" asp-action="DoiTrangThai" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="isActive" value="@(item.IsActive ? "false" : "true")" />
                                        <input type="hidden" name="tuKhoa" value="@Model.TuKhoa" />
                                        <input type="hidden" name="specialtyId" value="@Model.SpecialtyId" />
                                        <input type="hidden" name="trangThai" value="@(Model.TrangThai.HasValue ? (Model.TrangThai.Value ? "true" : "false") : "")" />
                                        <input type="hidden" name="page" value="@ds.PageIndex" />
                                        @if (item.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    data-confirm="Ngừng hoạt động bác sĩ '@item.FullName' và khóa tài khoản đăng nhập tương ứng?"
                                                    data-confirm-title="Ngừng hoạt động bác sĩ"
                                                    data-confirm-btn="Ngừng hoạt động"
                                                    data-confirm-variant="danger">
                                                <i class="bi bi-slash-circle" aria-hidden="true"></i>
                                                <span>Ngừng</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-success"
                                                    data-confirm="Kích hoạt lại bác sĩ '@item.FullName' và mở khóa tài khoản đăng nhập?"
                                                    data-confirm-title="Kích hoạt bác sĩ"
                                                    data-confirm-btn="Kích hoạt"
                                                    data-confirm-variant="success">
                                                <i class="bi bi-check-circle" aria-hidden="true"></i>
                                                <span>Kích hoạt</span>
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_AdminPaginationPartial" model="@(new AdminPaginationViewModel
{
    PageIndex = ds.PageIndex,
    TotalPages = ds.TotalPages,
    TotalCount = ds.TotalCount,
    StartItem = ds.StartItem,
    EndItem = ds.EndItem,
    ItemLabel = "bác sĩ",
    Controller = "BacSi",
    RouteValues = new Dictionary<string, string?>
    {
        ["tuKhoa"] = Model.TuKhoa,
        ["specialtyId"] = Model.SpecialtyId?.ToString(),
        ["trangThai"] = Model.TrangThai?.ToString()
    }
})" />
